{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "README.md"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
   "headers": [
  {
    "source": "**/*.@(jpg|jpeg|gif|png|svg|webp)",
    "headers": [
      {
        "key": "Cache-Control",
        "value": "max-age=31536000"
      }
    ]
  },
  {
    "source": "**/*.@(css|js)",
    "headers": [
      {
        "key": "Cache-Control",
        "value": "max-age=3600, must-revalidate"
      }
    ]
  }
]
  },
  "database": {
    "rules": "database.rules.json"
  }
}
