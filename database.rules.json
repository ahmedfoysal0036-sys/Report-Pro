
{
  "rules": {
    "reports": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$reportId": {
        ".validate": "newData.hasChildren(['id', 'date', 'shift'])"
      }
    },
    "personalFinance": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
